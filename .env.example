# 브라우저에 노출되는 Supabase publishable 설정입니다. 환경별 프로젝트/도메인 분리에 사용하며 비밀값 저장소가 아닙니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key

# 미설정 또는 *: 모든 HTTPS 부모 허용. 제한하려면 origin을 콤마로 구분합니다.
# 예: https://service.example.com,https://admin.example.com
VITE_EDITOR_PARENT_ORIGINS=*
